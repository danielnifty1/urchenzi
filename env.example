# Backend API — NEXT_PUBLIC_API_URL is the origin only (no path). The client uses <origin>/api/v1 for REST.
# Backward compatible: if the value already ends with /api/v1, it is used as-is.
# Example: https://api.example.com  →  requests go to https://api.example.com/api/v1/...
NEXT_PUBLIC_API_URL=http://localhost:3010
# Dev: Next rewrites /api/v1 → backend so the browser uses the same origin as the page (fixes CORS when
# opening http://LAN_IP:3001). Override backend address for the rewrite if needed:
# API_INTERNAL_ORIGIN=http://127.0.0.1:3010

# Multi-store vendor dashboard: /dashboard (overview), /dashboard/stores, /dashboard/stores/[storeId]/…
# Optional dev UUID when GET /me/stores is not available yet:
# NEXT_PUBLIC_DEV_STORE_ID=

# When GET /authz/me/permissions returns 404/501, map UI fallback to a role (DX only). Omit in production.
# NEXT_PUBLIC_RBAC_FALLBACK_ROLE=store_owner

# Align backend CORS ALLOWED_ORIGIN with this frontend origin; cookies for /auth/refresh + /auth/logout need credentials.
# Admin UI: /admin — requires JWT user.role === admin.
# Store dashboard: /dashboard — JWT + x-store-id (stores.id); permissions from GET /authz/me/permissions?storeId=
# Global metrics: GET /admin/overview (see services/adminDashboardApi.ts).
# Directory: GET /admin/vendors, /admin/riders, /admin/users — services/adminDirectoryApi.ts.
# Vendor workspace (admin): /admin/<vendorUuid>/... — approve|reject|suspend|ban|reinstate; vendor edits use owner session.
# RBAC admin UI: /admin/rbac — GET/POST /admin/rbac/* (see docs/nest-admin-rbac-module.md); optional GET /admin/me for gate.
# Legacy vendor hub: /vendor/dashboard (no x-store-id unless you align backend).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — only if you still use Firebase Analytics elsewhere
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
